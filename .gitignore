# ---- Rust / Cargo -----------------------------------------------------------
/target
**/*.rs.bk
*.pdb

# ---- 构建产物（sbin/package.sh 输出）---------------------------------------
/dist

# ---- 第三方参考源码 / 临时目录 ---------------------------------------------
# temp/ 存放用于对齐 UI 与实现的上游参考项目（FluxDown、gpui-kit、zedis 等），
# 体量大且非本项目源码，不入库。
/temp

# ---- 编辑器 / IDE -----------------------------------------------------------
.idea/
*.iml
.vscode/

# ---- macOS ------------------------------------------------------------------
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# ---- 日志 -------------------------------------------------------------------
*.log

# ---- Python -----------------------------------------------------------------
# sbin/*.py 是发布工具（不进客户端二进制），本地跑一次就会留下字节码缓存。
__pycache__/
*.py[cod]

.workbuddy/