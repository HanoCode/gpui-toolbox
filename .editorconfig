# 统一跨编辑器的缩进 / 换行 / 字符集，避免 AI 生成代码产生风格漂移。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 数据 / 配置类文件缩进 2 空格
[*.{yml,yaml,json,toml}]
indent_size = 2

# Markdown 行尾双空格是有意的换行标记，不裁剪
[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
