# JavaScript 速查表

## 变量与类型

```javascript
let x = 10;              // 可变变量
const y = 3.14;          // 常量
var old = "不推荐";      // 旧语法

// 数据类型
let str = "Hello";       // String
let num = 42;            // Number
let bool = true;         // Boolean
let arr = [1, 2, 3];     // Array
let obj = {name: "张三"}; // Object
let fn = () => {};       // Function
let sym = Symbol("id");  // Symbol
let big = 123n;          // BigInt
```

## 字符串

```javascript
const s = "Hello World";
s.toLowerCase();         // 转小写
s.toUpperCase();         // 转大写
s.trim();                // 去除空白
s.replace("H", "J");     // 替换
s.split(" ");            // 分割
["a","b"].join(",");     // 连接
s.includes("ello");      // 包含
s.indexOf("ello");       // 位置
s.slice(0, 5);           // 截取
`Name: ${name}`;       // 模板字符串
```

## 数组

```javascript
const arr = [1, 2, 3, 4, 5];
arr.push(6);             // 添加末尾
arr.pop();               // 弹出末尾
arr.unshift(0);          // 添加开头
arr.shift();             // 弹出开头
arr.splice(1, 2);        // 删除/插入
arr.slice(1, 3);         // 截取
arr.includes(3);         // 包含
arr.find(x => x > 2);   // 查找
arr.filter(x => x > 2); // 过滤
arr.map(x => x * 2);    // 映射
arr.reduce((a, b) => a + b, 0); // 归约
arr.forEach(x => console.log(x)); // 遍历
```

## 对象

```javascript
const person = {name: "张三", age: 25};
const {name, age} = person;  // 解构
const {name: n, age: a} = person; // 重命名
const {...copy} = person;     // 浅拷贝
```

## 函数

```javascript
// 传统函数
function greet(name) {
    return `Hello, ${name}`;
}

// 箭头函数
const greet = (name) => `Hello, ${name}`;

// 默认参数
const greet = (name = "World") => `Hello, ${name}`;

// 可变参数
const add = (...args) => args.reduce((a, b) => a + b, 0);
```

## 类

```javascript
class Person {
    constructor(name, age) {
        this.name = name;
        this.age = age;
    }
    greet() {
        return `我是${this.name}`;
    }
}
const p = new Person("张三", 25);
```

## 异步

```javascript
// Promise
fetch(url)
    .then(res => res.json())
    .then(data => console.log(data))
    .catch(err => console.error(err));

// async/await
async function fetchData() {
    try {
        const res = await fetch(url);
        const data = await res.json();
        return data;
    } catch (err) {
        console.error(err);
    }
}
```

## 解构与展开

```javascript
// 解构
const [a, b, ...rest] = [1, 2, 3, 4];
const {x, y, ...others} = {x: 1, y: 2, z: 3};

// 展开
const arr1 = [1, 2];
const arr2 = [...arr1, 3, 4];
const obj1 = {a: 1};
const obj2 = {...obj1, b: 2};
```

## ES6+ 特性

```javascript
// 可选链
const city = user?.address?.city;

// 空值合并
const name = user?.name ?? "匿名";

// Array.from
Array.from("hello"); // ["h","e","l","l","o"]

// Object.entries/keys/values
Object.entries({a: 1, b: 2}); // [["a",1],["b",2]]
Object.keys({a: 1, b: 2});    // ["a","b"]
Object.values({a: 1, b: 2});  // [1, 2]
```
